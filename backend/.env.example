# Copy to backend/.env. Never commit the real .env.

# Optional: OpenWeather current conditions (free key from openweathermap.org)
OPENWEATHER_API_KEY=

# Optional: chatbot LLM. Leave the key empty to use the deterministic template answers.
# anthropic: key from console.anthropic.com, model e.g. claude-opus-5-5
# gemini:    key from aistudio.google.com, model e.g. gemini-3.8-flash (used when LLM_MODEL is not a gemini model)
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-opus-5-5

# 1 = serve only recorded real responses from data/replay (demo without network)
JAGAPADI_OFFLINE=0
# 1 = save every live response to data/replay with its capture time
JAGAPADI_RECORD=0

# Optional: Telegram early warnings. Create a bot with @BotFather and paste its token.
# Run one API worker when this is set (the bot long-polls Telegram).
TELEGRAM_BOT_TOKEN=
JAGAPADI_ALERT_HOUR=6

JAGAPADI_MAX_FIELD_HA=200
JAGAPADI_CORS=http://localhost:5173

# Optional TUAI Sigap visible-pest fallback. The local ONNX model is always tried
# first. When enabled, each user must still opt in before a photo is sent to
# Roboflow. Never commit a real key.
TUAI_SIGAP_ROBOFLOW_FALLBACK=0
ROBOFLOW_API_KEY=
TUAI_SIGAP_ROBOFLOW_MODEL_ID=rice-pest-jmdev/1
TUAI_SIGAP_ROBOFLOW_TIMEOUT_SECONDS=30
